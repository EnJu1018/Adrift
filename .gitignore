apps/*/.env.*.local
!apps/*/.env.example
!**/.env.example

# Build output
dist/
build/
apps/*/dist/
apps/*/build/
coverage/
.nyc_output/

# Runtime files
*.log
*.err
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Uploaded files
apps/api/src/uploads/*
!apps/api/src/uploads/.gitkeep

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/

