# VPS: review the effective Match configuration and run sshd -t before reload.
# Existing administrative SSH and its port-22022 tunnel must remain unchanged.
Match User adrift-ai-tunnel
    AuthenticationMethods publickey
    PasswordAuthentication no
    KbdInteractiveAuthentication no
    AllowTcpForwarding remote
    GatewayPorts no
    PermitListen 127.0.0.1:11435
    PermitOpen none
    AllowAgentForwarding no
    X11Forwarding no
    PermitTTY no
    MaxSessions 0
Match all
