[Unit]
Description=Private local inference gateway
Wants=network-online.target
After=network-online.target ollama.service

[Service]
Type=simple
User=adrift-ai
Group=adrift-ai
WorkingDirectory=/opt/adrift-gateway/apps/api
EnvironmentFile=/etc/adrift-ai/gateway.env
ExecStart=/usr/bin/node src/local-ai/server.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=50
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
UMask=0077
MemoryMax=384M

[Install]
WantedBy=multi-user.target
