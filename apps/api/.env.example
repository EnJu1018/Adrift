PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# MONGODB_URI is the canonical name used by the backend.
# MONGO_URI is also supported for older deployments.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/<database>?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

OWNER_EMAIL=owner@example.com
ADMIN_EMAIL=

GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=
# Optional: set only after verifying access and free-tier availability for this project.
GEMINI_FALLBACK_MODEL=
AI_DAILY_LIMIT=20
AI_GLOBAL_DAILY_LIMIT=200
